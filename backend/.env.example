# MedGuard AI Environment Variables

# LLM Provider (Groq free tier)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Database
DATABASE_PATH=data/medguard.db

# Encryption
MEDGUARD_ENCRYPTION_KEY=your_fernet_key_here

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_MAX_CONCURRENT=3
SCRAPER_DELAY_MIN=1.5
SCRAPER_DELAY_MAX=4.0

# Pipeline
PIPELINE_SCHEDULE_HOURS=6
CONFIDENCE_THRESHOLD=0.70

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100

# Logging
LOG_LEVEL=INFO
